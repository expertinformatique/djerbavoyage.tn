<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirection 301 de www.djerbavoyage.tn vers djerbavoyage.tn (non-www)
    RewriteCond %{HTTP_HOST} ^www\.djerbavoyage\.tn$ [NC]
    RewriteRule ^(.*)$ https://djerbavoyage.tn/$1 [R=301,L]

    # 2. Redirection 301 HTTP vers HTTPS en production
    RewriteCond %{HTTP_HOST} ^djerbavoyage\.tn$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://djerbavoyage.tn/$1 [R=301,L]

    # Interdire le listing des répertoires
    Options -Indexes

    # Bloquer l'accès direct aux dossiers images sans fichier ciblé
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^assets/(images|videos)(/.*)?$ - [F,L]

    # Redirection transparente des images demandées sur /images/... vers /assets/images/...
    RewriteRule ^images/(.*)$ assets/images/$1 [L]

    # Routage dynamique prioritaire pour sitemap.xml et robots.txt
    RewriteRule ^sitemap\.xml$ index.php [QSA,L]
    RewriteRule ^robots\.txt$ index.php [QSA,L]

    # Rediriger vers index.php si ce n'est pas un fichier ou dossier existant
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
